@model CreditosApp.Models.ViewModels.PerfilClienteViewModel
@{
    ViewData["Title"] = "Perfil de cliente";
}

<h1 class="h3">Perfil de cliente</h1>

@if (ViewBag.Exito is string exito) { <div class="alert alert-success">@exito</div> }
@if (ViewBag.Error is string error) { <div class="alert alert-danger">@error</div> }

<form asp-action="Perfil" method="post" class="card card-body" style="max-width: 480px">
    <div class="mb-3">
        <label asp-for="IngresosMensuales" class="form-label"></label>
        <input asp-for="IngresosMensuales" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="IngresosMensuales" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
</form>

<a asp-action="Crear" class="btn btn-link mt-3">Ir a nueva solicitud &rarr;</a>
