@model CreditosApp.Models.ViewModels.NuevaSolicitudViewModel
@{
    ViewData["Title"] = "Nueva solicitud";
}

<h1 class="h3">Registrar solicitud de crédito</h1>

@if (ViewBag.Exito is string exito)
{
    <div class="alert alert-success">
        @exito
        <a asp-action="Detalle" asp-route-id="@ViewBag.SolicitudId" class="alert-link">Ver detalle</a>
    </div>
}
@if (ViewBag.Error is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!Model.TieneCliente)
{
    <div class="alert alert-warning">
        No tiene perfil de cliente. <a asp-action="Perfil" class="alert-link">Registre sus ingresos mensuales</a> para poder solicitar un crédito.
    </div>
}
else
{
    <p class="text-muted">
        Ingresos mensuales: <strong>@Formato.Soles(Model.IngresosMensuales ?? 0)</strong> ·
        Monto máximo permitido: <strong>@Formato.Soles((Model.IngresosMensuales ?? 0) * ReglasCredito.FactorMaximoRegistro)</strong>
        @if (!Model.ClienteActivo) { <span class="badge bg-danger ms-2">Cliente inactivo</span> }
    </p>
}

<form asp-action="Crear" method="post" class="card card-body" style="max-width: 480px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="MontoSolicitado" class="form-label"></label>
        <input asp-for="MontoSolicitado" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="MontoSolicitado" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Registrar solicitud</button>
</form>

<a asp-action="Index" class="btn btn-link mt-3">&larr; Mis solicitudes</a>
